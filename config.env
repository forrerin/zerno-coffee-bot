# ============================================================
#  Настройки бота «Зерно»
#  Вставьте токен своего бота после знака = и сохраните файл.
#  Токен выдаёт @BotFather в Telegram: /newbot
# ============================================================

BOT_TOKEN=

# ------------------------------------------------------------
#  Дальше можно ничего не трогать
# ------------------------------------------------------------

# Ключ Claude API для AI-бариста. Без ключа работает встроенный подбор по меню
ANTHROPIC_API_KEY=

# Демо-режим: админка открыта всем, заказы сами проходят статусы, Mini App открывается в браузере
DEMO_MODE=true
DEMO_OPEN_ADMIN=true
DEMO_AUTOPILOT=true

TIMEZONE=Europe/Moscow
