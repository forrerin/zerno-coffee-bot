# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# Публичный HTTPS-адрес Mini App (домен или туннель), например https://zerno.example.com
WEBAPP_URL=
# ID служебного чата для новых заказов (добавьте бота в группу, ID начинается с -100…)
STAFF_CHAT_ID=
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# --- AI-бариста ---
# Без ключа работает встроенный rule-based подбор по меню
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=20

# --- Демо-режимы (для портфолио) ---
# Открывать Mini App в обычном браузере без Telegram (демо-пользователь с правами админа)
DEMO_MODE=false
# Пускать в админку всех, кто открыл бота (для публичного демо)
DEMO_OPEN_ADMIN=false
# Заказы сами проходят статусы «готовится» → «готов», если нет живого бариста
DEMO_AUTOPILOT=false

# --- Инфраструктура ---
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_USER=zerno
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zerno

# --- Логи ---
SENTRY_DSN=
TIMEZONE=Europe/Moscow

# gist с адресом API для Mini App на GitHub Pages (обновляется при запуске start.bat)
WEBAPP_STATIC_URL=
API_GIST_ID=
